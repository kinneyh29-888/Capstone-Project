import tkinter as tk
from PIL import Image, ImageTk

# Function to handle selection
def select_shape(shape):
    result_label.config(text=f"You selected: {shape}")

# Create main window
root = tk.Tk()
root.title("Choose a Shape")
root.geometry("500x300")

title = tk.Label(root, text="Select a Shape", font=("Arial", 18))
title.pack(pady=10)

frame = tk.Frame(root)
frame.pack()

# Load images
circle_img = Image.open("circle.png")
circle_img = circle_img.resize((100, 100))
circle_photo = ImageTk.PhotoImage(circle_img)

square_img = Image.open("square.png")
square_img = square_img.resize((100, 100))
square_photo = ImageTk.PhotoImage(square_img)

# Create buttons with images
circle_button = tk.Button(
    frame,
    image=circle_photo,
    command=lambda: select_shape("Circle")
)
circle_button.grid(row=0, column=0, padx=20)

square_button = tk.Button(
    frame,
    image=square_photo,
    command=lambda: select_shape("Square")
)
square_button.grid(row=0, column=1, padx=20)

result_label = tk.Label(root, text="", font=("Arial", 14))
result_label.pack(pady=20)

root.mainloop()
