import math
from pyniryo import *

ROBOT_IP = "10.10.10.10"

# Workspace boundaries (meters)
MIN_X = 0.15
MAX_X = 0.35

MIN_Y = -0.10
MAX_Y = 0.10

# Z heights
DRAW_Z = 0.10
TRAVEL_Z = 0.14

# Robot orientation
ROLL = 0
PITCH = 1.57
YAW = 0

def scale_coordinate(x, y):

    robot_x = MIN_X + (x / 100.0) * (MAX_X - MIN_X)

    robot_y = MIN_Y + (y / 100.0) * (MAX_Y - MIN_Y)

    return robot_x, robot_y

def generate_circle():

    points = []

    radius = 35

    for deg in range(0, 361, 5):

        rad = math.radians(deg)

        x = 50 + radius * math.cos(rad)
        y = 50 + radius * math.sin(rad)

        points.append((x, y))

    return points


def generate_square():

    return [
        (20, 20),
        (80, 20),
        (80, 80),
        (20, 80),
        (20, 20)
    ]


def generate_triangle():

    return [
        (50, 85),
        (15, 15),
        (85, 15),
        (50, 85)
    ]


def generate_spiral():

    points = []

    for t in range(0, 720, 5):

        angle = math.radians(t)

        radius = t * 0.05

        x = 50 + radius * math.cos(angle)
        y = 50 + radius * math.sin(angle)

        points.append((x, y))

    return points


def generate_wave():

    points = []

    for x in range(0, 101, 2):

        y = 50 + 20 * math.sin(x * 0.15)

        points.append((x, y))

    return points


def generate_heart():

    points = []

    for t in range(0, 360, 3):

        rad = math.radians(t)

        x = 16 * math.sin(rad) ** 3

        y = (
            13 * math.cos(rad)
            - 5 * math.cos(2 * rad)
            - 2 * math.cos(3 * rad)
            - math.cos(4 * rad)
        )

        # Normalize
        x = 50 + x * 2
        y = 50 + y * 2

        points.append((x, y))

def generate_trapezoid():

    return [
        (30, 20),
        (70, 20),
        (85, 80),
        (15, 80),
        (30, 20)
    ]


def generate_hexagon():

    points = []

    center_x = 50
    center_y = 50
    radius = 35

    for deg in range(0, 361, 60):

        rad = math.radians(deg)

        x = center_x + radius * math.cos(rad)
        y = center_y + radius * math.sin(rad)

        points.append((x, y))

    return points


def generate_poke_a_dots():

    points = []

    dot_spacing = 20
    dot_radius = 3

    for center_x in range(20, 81, dot_spacing):

        for center_y in range(20, 81, dot_spacing):

            for deg in range(0, 361, 30):

                rad = math.radians(deg)

                x = center_x + dot_radius * math.cos(rad)
                y = center_y + dot_radius * math.sin(rad)

                points.append((x, y))

