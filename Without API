def generate_shape(shape_name):

    shape_name = shape_name.lower()

    if shape_name == "circle":
        return generate_circle()

    elif shape_name == "square":
        return generate_square()

    elif shape_name == "triangle":
        return generate_triangle()

    elif shape_name == "spiral":
        return generate_spiral()

    elif shape_name == "wave":
        return generate_wave()

    elif shape_name == "heart":
        return generate_heart()

    elif shape_name == "trapezoid":
        return generate_trapezoid()

    elif shape_name == "hexagon":
        return generate_hexagon()

    elif shape_name == "polka dots":
        return generate_polka_dots()

    else:
        print("Unknown shape. Using circle.")
        return generate_square()

print("Connecting to Ned2 robot...")

robot = NiryoRobot(ROBOT_IP)

robot.calibrate_auto()

robot.update_tool()

print("Robot connected.")

def move_to(x, y, z):

    robot.move_pose(
        x,
        y,
        z,
        ROLL,
        PITCH,
        YAW
    )

def draw_shape(points):

    if len(points) == 0:
        return

    print(f"Drawing {len(points)} points...")

    first_x, first_y = scale_coordinate(
        points[0][0],
        points[0][1]
    )

    # Move above start point
    move_to(first_x, first_y, TRAVEL_Z)

    # Pen down
    move_to(first_x, first_y, DRAW_Z)

    for point in points:

        x = max(0, min(100, point[0]))
        y = max(0, min(100, point[1]))

        robot_x, robot_y = scale_coordinate(x, y)

        print(f"Moving to X={robot_x:.3f}, Y={robot_y:.3f}")

        move_to(
            robot_x,
            robot_y,
            DRAW_Z
        )

    # Pen up
    move_to(robot_x, robot_y, TRAVEL_Z)

    print("Drawing complete.")

try:

    print("\n=== OFFLINE AI-LIKE DRAWING SYSTEM ===\n")

    print("Available shapes:")
    print("- circle")
    print("- square")
    print("- triangle")
    print("- spiral")
    print("- wave")
    print("- heart")
    print("- trapezoid")
    print("- hexagon")
    print("- polka dots")

    shape = input("\nEnter shape:\n> ")

    points = generate_shape(shape)

    draw_shape(points)

except Exception as e:

    print("\nERROR:")
    print(e)

finally:

    print("\nClosing robot connection...")

    robot.close_connection()

    print("Done.")
