import xml.etree.ElementTree as ET
import re
import math
from pyniryo import *

SVG_FILE = "output.svg"
WORKSPACE_NAME = "Drawing_Workspace"

ROBOT_IP = "10.10.10.10"

# Drawing heights
Z_DRAW = 0.01        # pen touching paper
Z_LIFT = 0.05        # pen lifted

# Workspace scaling (relative coordinates 0→1)
SVG_SCALE_X = 1.0
SVG_SCALE_Y = 1.0

robot = NiryoRobot(ROBOT_IP)

robot.calibrate_auto()
robot.update_tool()

# =========================================================
# OBSERVATION / START POSE
# =========================================================

start_pose = [
]

robot.move_joints(start_pose)

tree = ET.parse(SVG_FILE)
root = tree.getroot()

# SVG namespace handling
ns = {'svg': 'http://www.w3.org/2000/svg'}

svg_width = float(root.attrib.get("width", "500").replace("px", ""))
svg_height = float(root.attrib.get("height", "500").replace("px", ""))

print("SVG size:", svg_width, svg_height)

def parse_path_d(path_d):
    """
    Very basic parser for M and L commands.
    Supports:
      M x y
      L x y
    """

    tokens = re.findall(r'[ML]|-?\d+\.?\d*', path_d)

    coords = []

    i = 0

    current_cmd = None

    while i < len(tokens):

        token = tokens[i]

        if token in ['M', 'L']:
            current_cmd = token
            i += 1
            continue

        x = float(tokens[i])
        y = float(tokens[i + 1])

        coords.append((x, y))

        i += 2

    return coords

def svg_to_workspace(x, y):

    # Normalize
    rel_x = x / svg_width
    rel_y = y / svg_height

    # Flip Y axis
    rel_y = 1.0 - rel_y

    # Scale if needed
    rel_x *= SVG_SCALE_X
    rel_y *= SVG_SCALE_Y

    return rel_x, rel_y

def draw_polyline(points):

    if len(points) < 2:
        return

    # Move above first point
    first_x, first_y = svg_to_workspace(points[0][0], points[0][1])

    robot.move_pose(
        *robot.get_target_pose_from_rel(
            WORKSPACE_NAME,
            first_x,
            first_y,
            Z_LIFT,
            0
        ).to_list()
    )

    # Lower pen
    robot.move_pose(
        *robot.get_target_pose_from_rel(
            WORKSPACE_NAME,
            first_x,
            first_y,
            Z_DRAW,
            0
        ).to_list()
    )

    # Draw path
    for x, y in points:

        rel_x, rel_y = svg_to_workspace(x, y)

        pose = robot.get_target_pose_from_rel(
            WORKSPACE_NAME,
            rel_x,
            rel_y,
            Z_DRAW,
            0
        )

        robot.move_pose(*pose.to_list())

    # Lift pen
    last_x, last_y = svg_to_workspace(points[-1][0], points[-1][1])

    robot.move_pose(
        *robot.get_target_pose_from_rel(
            WORKSPACE_NAME,
            last_x,
            last_y,
            Z_LIFT,
            0
        ).to_list()
    )

# Handle polygons
for polygon in root.findall('.//{http://www.w3.org/2000/svg}polygon'):

    points_attr = polygon.attrib.get('points', '')

    raw_points = points_attr.strip().split()

    points = []

    for p in raw_points:

        x, y = p.split(',')

        points.append((float(x), float(y)))

    print(f"Drawing polygon with {len(points)} points")

    draw_polyline(points)

# Handle paths
for path in root.findall('.//{http://www.w3.org/2000/svg}path'):

    d = path.attrib.get('d', '')

    points = parse_path_d(d)

    print(f"Drawing path with {len(points)} points")

    draw_polyline(points)

robot.move_joints(start_pose)

robot.close_connection()

print("Drawing complete!")
