# Connect to robot with simple retry wrapper
def connect_robot(ip, attempts=3, delay=2):
    for i in range(attempts):
        try:
            r = NiryoRobot(ip)
            print(f"Connected to server ({ip}) on attempt {i+1}")
            return r
        except Exception as e:
            print(f"Connection attempt {i+1} failed: {e}")
            if i < attempts - 1:
                time.sleep(delay)
    raise RuntimeError(f"Unable to connect to robot at {ip} after {attempts} attempts")

