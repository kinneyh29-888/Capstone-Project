def clear_collision_if_needed():
    try:
        if hasattr(robot, 'clear_collision_detected'):
            robot.clear_collision_detected()
    except Exception:
        try:
            robot.arm.clear_collision_detected()
        except Exception:
            pass

def do_move_joints(joints):
